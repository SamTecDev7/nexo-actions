* text=auto

# WSL and systemd files must never receive CRLF line endings.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.pa text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Native Windows sources and scripts remain friendly to Windows editors.
*.ps1 text eol=crlf
*.cs text eol=crlf
*.manifest text eol=crlf

# Release and visual artifacts are binary.
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
